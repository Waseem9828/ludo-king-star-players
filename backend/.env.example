PORT=5000
MONGO_URI=mongodb://localhost:27017/mewat-play-chips
JWT_SECRET=

# API-King OTP SMS (https://api.api-king.com/api/v1/otp/send)
# Sent as: Authorization: <key>  (no "Bearer" prefix)
API_KING_KEY=

# IMB Payment Gateway (https://api.imbpay.in/v2/create-order)
# Sent as the "user_token" form field, never exposed to the frontend.
IMB_API_TOKEN=your_imb_api_token_here
